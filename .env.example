# ==============================================================================
# SkillPulse — Environment Variables Example Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Supabase Backend & Database Credentials
# ------------------------------------------------------------------------------
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. Google Gemini API Credentials (LLM Understanding & Skill Gap Analysis)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Gemini model name
VITE_GEMINI_MODEL=gemini-flash-latest
